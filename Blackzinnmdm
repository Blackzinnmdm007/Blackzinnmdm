-- FUNCOES BASICAS

local function conectar(sinal, fn)
    local c = sinal:Connect(fn)
    table.insert(conexoes,c)
    return c
end

local function criar(tipo, props, pai)
    local obj = Instance.new(tipo)
    for k,v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = pai
    return obj
end

local function root()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function normalizar(t)
    t = tostring(t or ""):lower()

    local trocas = {
        ["á"]="a", ["à"]="a", ["ã"]="a",
        ["â"]="a", ["é"]="e", ["ê"]="e",
        ["í"]="i", ["ó"]="o", ["ô"]="o",
        ["õ"]="o", ["ú"]="u", ["ç"]="c"
    }

    for a,b in pairs(trocas) do
        t = t:gsub(a,b)
    end

    return t
end

