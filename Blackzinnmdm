-- CICLO PRINCIPAL

task.spawn(function()
    while not encerrado and gui.Parent do
        if ativo then
            local id = sessao
            local ignorados = {}

            for i,ponto in ipairs(coordenadas) do
                if not valido(id) then break end

                if botaoSoltarVisivel() then
                    if not entregarNaBase(id) then break end
                end

                atualizar("Area "..i.."/"..#coordenadas)

                if not teleportar(ponto,id) then break end

                local ovo = procurarNaArea(ponto,ignorados)

                if ovo and valido(id) then
                    atualizar("Ovo localizado")

                    if teleportar(posicao(ovo),id) then
                        atualizar("Coletando ovo")
                        local prompt = promptDoOvo(ovo)

                        if coletar(prompt,id) then
                            atualizar("Ovo na mao")

                            if levarBase then
                                if not entregarNaBase(id) then
                                    break
                                end
                            else
                                atualizar("Ovo coletado")
                            end
                        else
                            atualizar("Coleta nao confirmada")
                        end
                    end

                    ignorados[ovo] = true
                end
            end
        else
            task.wait(.25)
        end
        task.wait(.1)
    end
end)
