-- OTIMIZACAO

local function ocultar(obj)
    if obj and obj.Parent and not objetosOcultos[obj] then
        objetosOcultos[obj] = obj.Parent
        obj.Parent = nil
    end
end

local function aplicarOtimizacao()
    ocultar(workspace:FindFirstChild("FuseMachineKit"))
    ocultar(workspace:FindFirstChild("MutationMachineKit"))

    -- Ovos colocados nas bases
    for _,plot in ipairs(workspace:GetChildren()) do
        if plot.Name:match("^Plot_") then
            ocultar(plot:FindFirstChild("EggHatch"))
        end
    end

    -- Cercas
    for _,plot in ipairs(workspace:GetChildren()) do
        if plot.Name:match("^Plot_") then
            local estrutura = plot:FindFirstChild("Base")

            if estrutura then
                for _,obj in ipairs(estrutura:GetChildren()) do
                    if obj.Name == "Part"
                        and obj:IsA("BasePart") then
                        ocultar(obj)
                    end
                end
            end
        end
    end

    -- Decoracoes
    local mapa = workspace:FindFirstChild("Map")

    if mapa then
        local decor = mapa:FindFirstChild("Decor")
        if decor then ocultar(decor) end
    end
end

local function restaurarOtimizacao()
    for obj,pai in pairs(objetosOcultos) do
        if obj and pai then
            pcall(function()
                obj.Parent = pai
            end)
        end

        objetosOcultos[obj] = nil
    end
end

conectar(bOtimizar.MouseButton1Click,function()
    otimizar = not otimizar

    if otimizar then
        aplicarOtimizacao()
        bOtimizar.Text = "[X] Otimização"
        atualizar("Otimização ativada")
    else
        restaurarOtimizacao()
        bOtimizar.Text = "[ ] Otimização"
        atualizar("Otimização desativada")
    end
end)

conectar(workspace.DescendantAdded,function(obj)
