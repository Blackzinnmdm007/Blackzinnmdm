-- BLACKLIST COSMICO

local function blacklist(ovo)
    local function bloqueado(valor)
        local t = normalizar(valor)
        return t:find("cosmico",1,true) ~= nil
            or t:find("cosmic",1,true) ~= nil
    end

    if bloqueado(ovo.Name)
        or bloqueado(ovo:GetAttribute("Rarity"))
        or bloqueado(ovo:GetAttribute("Raridade")) then
        return true
    end

    local tag = ovo:FindFirstChild("EggNameTag",true)
    if tag then
        for _,v in ipairs(tag:GetDescendants()) do
            if (v:IsA("TextLabel") or v:IsA("TextButton"))
                and bloqueado(v.Text) then
                return true
            end
        end
    end
    return false
end

-- IDENTIFICAR RARIDADE

local function raridade(ovo)
    if blacklist(ovo) then return nil end

    local tag = ovo:FindFirstChild("EggNameTag",true)
    if not tag then return nil end

    local nomes = {
        segredo = {"segredo","secret"},
        eterno = {"eterno","eternal"},
        divino = {"divino","divine"}
    }

    for _,v in ipairs(tag:GetDescendants()) do
        if v:IsA("TextLabel") then
            local t = normalizar(v.Text)

            for chave,lista in pairs(nomes) do
                if filtros[chave] then
                    for _,nome in ipairs(lista) do
                        if t:find(nome,1,true) then
                            return chave
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function promptDoOvo(ovo)
    local a = ovo:FindFirstChild("PromptAnchor",true)
    return a and a:FindFirstChildWhichIsA(
        "ProximityPrompt",true
    )
end

local function posicao(ovo)
    local a = ovo:FindFirstChild("PromptAnchor",true)
    if a then
        if a:IsA("BasePart") then
            return a.Position
        elseif a:IsA("Attachment") then
            return a.WorldPosition
        end
    end
    return ovo:GetPivot().Position
end

local function chocando(ovo)
    if not ignorarChocando then return false end
    local n = normalizar(ovo.Name)
    return n:find("hatch",1,true) ~= nil
        or n:find("chocando",1,true) ~= nil
end

-- RADAR

local function procurarNaArea(ponto,ignorados)
    local pasta = workspace:FindFirstChild("Eggs")
    if not pasta then return nil end

    local melhor,menor = nil,math.huge

    for _,ovo in ipairs(pasta:GetDescendants()) do
        if ovo:IsA("Model")
            and ovo.Name == "SpawnedEgg"
            and not ignorados[ovo]
            and not chocando(ovo)
            and raridade(ovo) then

            local prompt = promptDoOvo(ovo)

            if prompt and prompt.Enabled then
                local d = (posicao(ovo)-ponto).Magnitude

                if d <= distanciaRadar and d < menor then
                    melhor = ovo
                    menor = d
                end
            end
        end
    end
    return melhor
end

-- DETECTAR OVO NA MAO

local function botaoSoltarVisivel()
    for _,v in ipairs(pg:GetDescendants()) do
        if v:IsA("GuiButton")
            and not v:IsDescendantOf(gui) then

            local nome = normalizar(v.Name)
            local t = v:IsA("TextButton")
                and normalizar(v.Text) or ""

            if nome:find("drop",1,true)
                or nome:find("soltar",1,true)
                or t:find("drop",1,true)
                or t:find("soltar",1,true) then

                local visivel = v.Visible
                local pai = v.Parent

                while visivel and pai do
                    if pai:IsA("GuiObject") and not pai.Visible then
                        visivel = false
                    end
                    if pai:IsA("ScreenGui") and not pai.Enabled then
                        visivel = false
                    end
                    pai = pai.Parent
                end

                if visivel then return true end
            end
        end
    end
    return false
end

-- CONTROLE

local function valido(id)
    return not encerrado
        and ativo
        and sessao == id
        and gui.Parent ~= nil
end

local function esperar(t,id)
    local fim = os.clock()+t
    while os.clock()<fim do
        if not valido(id) then return false end
        task.wait(.05)
    end
    return valido(id)
end

-- TELEPORTE

local function teleportar(ponto,id)
    local r = root()
    if not r or not valido(id) then return false end

    r.CFrame = CFrame.new(ponto+Vector3.new(0,3,0))
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    return esperar(velocidadeTP,id)
end

-- COLETAR

local function coletar(prompt,id)
    if not prompt or not valido(id) then return false end

    if type(fireproximityprompt) ~= "function" then
        atualizar("Prompt indisponivel")
        return false
    end

    local ok = pcall(function()
        fireproximityprompt(prompt)
    end)

    if not ok then return false end

    local limite = os.clock()+7
    while os.clock()<limite do
        if not valido(id) then return false end
        if botaoSoltarVisivel() then return true end
        task.wait(.1)
    end
    return false
end

-- ENTREGA NA BASE

local function entregarNaBase(id)
    if not base or not valido(id) then return false end

    local r = root()
    if not r then return false end

    atualizar("Levando ovo para base")
    r.CFrame = base
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    if not esperar(.5,id) then return false end

    local limite = os.clock()+15
    local sumiuDesde = nil

    while os.clock()<limite do
        if not valido(id) then return false end

        if not botaoSoltarVisivel() then
            sumiuDesde = sumiuDesde or os.clock()

            if os.clock()-sumiuDesde >= .6 then
                entregas += 1
                contador.Text = "Ovos coletados: "..entregas
                atualizar("Ovo depositado")
                return true
            end
        else
            sumiuDesde = nil
            atualizar("Aguardando deposito")
        end

        task.wait(.1)
    end
    atualizar("Entrega nao confirmada")
    return false
end

