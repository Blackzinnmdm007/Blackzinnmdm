local function new(class, parent, props)
    local obj = Instance.new(class)
    for k,v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    new("UICorner", obj, {
        CornerRadius = UDim.new(0, radius or 9)
    })
end

local function outline(obj, thickness)
    new("UIStroke", obj, {
        Color = BLUE,
        Thickness = thickness or 1.5
    })
end

local function text(parent, value, pos, size, fontSize)
    return new("TextLabel", parent, {
        Position = pos,
        Size = size,
        BackgroundTransparency = 1,
        Text = value,
        TextColor3 = WHITE,
        TextStrokeTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = fontSize or 13,
        TextWrapped = true,
        ZIndex = 5
    })
end

local function button(parent, value, pos, size)
    local b = new("TextButton", parent, {
        Position = pos,
        Size = size,
        BackgroundColor3 = DARK,
        BackgroundTransparency = 0.08,
        Text = value,
        TextColor3 = WHITE,
        TextStrokeTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Active = true,
        ZIndex = 7
    })
    corner(b, 9)
    outline(b)
    return b
end

