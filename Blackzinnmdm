local function criar(tipo,props,pai)
    local obj = Instance.new(tipo)
    for k,v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = pai
    return obj
end

local function borda(obj)
    criar("UICorner",{
        CornerRadius = UDim.new(0,9)
    },obj)

    criar("UIStroke",{
        Color = roxo,
        Thickness = 1.5
    },obj)
end

local function botao(nome,pos,tamanho,pai)
