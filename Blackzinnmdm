        Text = nome,
        Position = pos,
        Size = tamanho,
        BackgroundColor3 = fundo,
        TextColor3 = branco,
        TextSize = 14,
        TextWrapped = true,
        Font = Enum.Font.GothamBold,
        ZIndex = 5
    },pai)
    borda(b)
    return b
end

local function texto(nome,pos,tamanho,pai,sz)
    return criar("TextLabel",{
        Text = nome,
        Position = pos,
        Size = tamanho,
        BackgroundTransparency = 1,
        TextColor3 = branco,
        TextSize = sz or 14,
        TextWrapped = true,
        Font = Enum.Font.GothamBold,
        ZIndex = 5
    },pai)
end

local function normalizar(t)
    t = tostring(t or ""):lower()
    local mapa = {
        ["á"]="a",["à"]="a",["ã"]="a",
        ["â"]="a",["é"]="e",["ê"]="e",
        ["í"]="i",["ó"]="o",["ô"]="o",
        ["õ"]="o",["ú"]="u",["ç"]="c"
    }
    for a,b in pairs(mapa) do
        t = t:gsub(a,b)
    end
    return t
end

local function root()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

