-- INDEXACAO DE PROMPTS

local function register(obj)
    if obj:IsA("ProximityPrompt") then
        prompts[obj] = true
        scanDirty = true
    end
end

local function unregister(obj)
    prompts[obj] = nil
    candidates[obj] = nil
    ignored[obj] = nil
    scanDirty = true
end

table.insert(connections,
    Workspace.DescendantAdded:Connect(register)
)

table.insert(connections,
    Workspace.DescendantRemoving:Connect(unregister)
)

task.spawn(function()
    for i,obj in ipairs(
        Workspace:GetDescendants()
    ) do
        if not running then return end

        register(obj)

        if i%200 == 0 then
            task.wait()
        end
    end

    ready = true
    scanDirty = true
    radarStatus.Text = "Radar V12 pronto!"
end)

-- ATUALIZAR FILA DE CANDIDATOS

local function refreshCandidates()
    local newCandidates = {}
    local total = 0
    local eggPrompts = 0
    local valid = 0

    for prompt in pairs(prompts) do
        if not running then return end

        total = total + 1

        if prompt.Parent
            and prompt.Enabled
            and isEggPrompt(prompt)
            and not forbidden(prompt) then

            eggPrompts = eggPrompts + 1

            local p = position(prompt)

            if p and not nearBase(p) then
                local rarity = detect(prompt)

                if rarity then
                    valid = valid + 1
                    newCandidates[prompt] = rarity
                end
            end
        end

        if total%35 == 0 then
            task.wait()
        end
    end

    candidates = newCandidates

    statusDetail.Text =
        "Prompts indexados: "..total..
        "\nInterações de ovo: "..eggPrompts..
        "\nOvos válidos: "..valid..
        "\nRadar: Segredo / Eterno / Divino"..
        "\nBusca rápida: 0.15s"

    scanDirty = false
end

-- SELECIONAR OVO MAIS PROXIMO

local function nextEgg()
    local r = root()
    if not r then return nil end

    local best
    local bestDistance = math.huge

    for prompt,rarity in pairs(candidates) do
        if prompt.Parent
            and prompt.Enabled
            and not forbidden(prompt)
            and not ignored[prompt] then

            local p = position(prompt)

            if p and not nearBase(p)
                and cfg[rarity] then

                local distance =
                    (p-r.Position).Magnitude

                if distance < bestDistance then
                    bestDistance = distance

                    best = {
                        prompt = prompt,
                        rarity = rarity
                    }
                end
            end
        end
    end

    return best
end

-- COLETAR

local function collect(target)
    busy = true

    local prompt = target.prompt
    local p = position(prompt)

    if not p or not prompt.Parent
        or not prompt.Enabled
        or not isEggPrompt(prompt)
        or forbidden(prompt)
        or nearBase(p) then

        busy = false
        return
    end

    local rarity = detect(prompt)

    if rarity ~= target.rarity then
        candidates[prompt] = nil
        busy = false
        return
    end

    radarStatus.Text =
        "Teleportando: "..rarity

    teleport(
        CFrame.new(p+Vector3.new(0,2,0))
    )

    task.wait(cfg.CollectDelay)

    if not running or not cfg.Auto then
        if base then teleport(base) end
        busy = false
        return
    end

    local success = false

    if type(fireproximityprompt)
        == "function" then

        success = pcall(function()
            fireproximityprompt(prompt)
        end)
    end

    radarStatus.Text = success
        and "Interação enviada: "..rarity
        or "Falha ao acionar coleta"

    task.wait(cfg.CollectWait)

    if base then teleport(base) end

    ignored[prompt] =
        os.clock()+cfg.RetryDelay

    busy = false
end

-- LOOP DE ATUALIZACAO DO RADAR

task.spawn(function()
    while running and gui.Parent do
        if ready and scanDirty then
            refreshCandidates()
        end

        task.wait(cfg.RefreshInterval)
        scanDirty = true
    end
end)

-- LOOP DE REACAO RAPIDA

task.spawn(function()
    while running and gui.Parent do
        if ready and cfg.Auto and not busy then
            for prompt,expiry in pairs(ignored) do
                if os.clock() >= expiry
                    or not prompt.Parent then

                    ignored[prompt] = nil
                end
            end

            local target = nextEgg()

            if target then
                collect(target)
            else
                radarStatus.Text =
                    "Procurando ovos selecionados..."
            end
        end

        task.wait(cfg.SearchInterval)
    end
end)

