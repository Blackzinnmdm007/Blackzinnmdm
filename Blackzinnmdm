local function pararTudo()
    if encerrado then return end

    encerrado = true
    ativo = false
    sessao = sessao+1
    otimizar = false

    restaurarOtimizacao()

    for _,c in ipairs(conexoes) do
        c:Disconnect()
    end

    gui:Destroy()
end

