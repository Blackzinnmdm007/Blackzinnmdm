
-- EGG AUTO FARM
-- Secret / Divine / Colossal

local Players = game:GetService("Players")
local TCS = game:GetService("TextChatService")
local WS = game:GetService("Workspace")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("EggFarmGUI")
if old then old:Destroy() end

local base
local ativo = false
local ocupado = false
local raridades = {
    Secret = true,
    Divine = true,
    Colossal = true
}

local ignorados = {}
local ultimaRegiao = "Nenhuma"

-- INTERFACE

local gui = Instance.new("ScreenGui")
gui.Name = "EggFarmGUI"
gui.ResetOnSpawn = false
gui.Parent = pg

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(265,390)
frame.Position = UDim2.new(.5,-132,.25,0)
frame.BackgroundColor3 = Color3.fromRGB(18,20,30)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

Instance.new("UICorner",frame).CornerRadius =
    UDim.new(0,12)

local function texto(t,y)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1,-16,0,32)
    l.Position = UDim2.fromOffset(8,y)
    l.BackgroundTransparency = 1
    l.TextColor3 = Color3.new(1,1,1)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 14
    l.Text = t
    l.TextScaled = false
    l.Parent = frame
    return l
end

texto("EGG AUTO FARM",8)
local status = texto("Status: Desligado",342)

local function botao(t,y,fn)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-20,0,43)
    b.Position = UDim2.fromOffset(10,y)
    b.BackgroundColor3 = Color3.fromRGB(35,105,225)
    b.TextColor3 = Color3.new(1,1,1)
    b.TextSize = 15
    b.Font = Enum.Font.GothamBold
    b.Text = t
    b.Parent = frame

    Instance.new("UICorner",b).CornerRadius =
        UDim.new(0,8)

    b.MouseButton1Click:Connect(function()
        fn(b)
    end)
end

local function root()
    local char = player.Character
    return char and
        char:FindFirstChild("HumanoidRootPart")
end

local function tpBase()
    local r = root()
    if r and base then
        r.CFrame = base
        return true
    end
    return false
end

-- BOTÕES

botao("Salvar Base",42,function(b)
    local r = root()
    if r then
        base = r.CFrame
        b.Text = "Base Salva!"
        status.Text = "Base registrada"
    end
end)

local ordem = {"Secret","Divine","Colossal"}

for i,nome in ipairs(ordem) do
    botao(nome .. ": ON",42+i*49,function(b)
        raridades[nome] = not raridades[nome]
        b.Text = nome .. ": " ..
            (raridades[nome] and "ON" or "OFF")
    end)
end

botao("Auto Farm: OFF",240,function(b)
    if not ativo and not base then
        status.Text = "Salve a base primeiro!"
        return
    end

    ativo = not ativo
    b.Text = "Auto Farm: " ..
        (ativo and "ON" or "OFF")

    status.Text = ativo
        and "Procurando ovos..."
        or "Desligado"
end)

botao("TP Base",290,function()
    if not tpBase() then
        status.Text = "Base não salva!"
    end
end)

-- FILTRO DE RARIDADES

local function raridadeValida(t)
    t = t:lower()

    for nome,ligado in pairs(raridades) do
        if ligado and t:find(
            nome:lower(),1,true
        ) then
            return true
        end
    end

    return false
end

-- IGNORAR CHOCADEIRAS

local palavrasChocando = {
    "hatch",
    "incubat",
    "chocando",
    "chocadeira",
    "eclosao",
    "eclosão"
}

local function ovoChocando(obj)
    local atual = obj

    for i = 1,5 do
        if not atual or atual == WS then
            break
        end

        local function verificar(t)
            t = tostring(t):lower()

            for _,p in ipairs(palavrasChocando) do
                if t:find(p,1,true) then
                    return true
                end
            end
            return false
        end

        if verificar(atual.Name) then
            return true
        end

        for _,v in ipairs(atual:GetDescendants()) do
            if v:IsA("TextLabel")
                and verificar(v.Text) then
                return true
            end
        end

        atual = atual.Parent
    end

    return false
end

-- ENCONTRAR BOTÃO DE COLETA

local function procurarPrompt(part)
    local atual = part

    for i = 1,4 do
        if not atual or atual == WS then
            break
        end

        for _,v in ipairs(atual:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                local t = (
                    v.ActionText .. " " ..
                    v.ObjectText
                ):lower()

                if t:find("ovo",1,true)
                    or t:find("egg",1,true) then
                    return v
                end
            end
        end

        atual = atual.Parent
    end
end

-- ENCONTRAR PARTE DO OVO

local function obterParte(g)
    local p = g.Adornee

    if p and p:IsA("BasePart") then
        return p
    end

    p = g.Parent

    if p:IsA("BasePart") then
        return p
    end

    if p:IsA("Model") then
        return p.PrimaryPart
            or p:FindFirstChildWhichIsA(
                "BasePart",true)
    end
end

-- PROCURAR APENAS OVOS

local function procurarOvo()
    local r = root()
    if not r then return end

    local melhor
    local menor = math.huge

    for _,g in ipairs(WS:GetDescendants()) do
        if g:IsA("BillboardGui")
            and not ovoChocando(g) then

            local t = ""

            for _,v in ipairs(g:GetDescendants()) do
                if v:IsA("TextLabel") then
                    t = t .. " " .. v.Text
                end
            end

            local lower = t:lower()

            local ehOvo =
                lower:find("ovo",1,true)
                or lower:find("egg",1,true)

            if ehOvo and raridadeValida(t) then
                local part = obterParte(g)

                if part
                    and not ovoChocando(part)
                    and not ignorados[part] then

                    local prompt = procurarPrompt(part)

                    if prompt then
                        local d =
                            (r.Position-part.Position).Magnitude

                        if d < menor then
                            menor = d
                            melhor = {
                                part = part,
                                prompt = prompt
                            }
                        end
                    end
                end
            end
        end
    end

    return melhor
end

-- COLETAR E VOLTAR À BASE

local function coletar(ovo)
    local r = root()
    if not r or not ativo then return end

    local part = ovo.part
    local prompt = ovo.prompt

    if not part.Parent
        or not prompt.Parent
        or ovoChocando(part) then
        return
    end

    status.Text = "Indo até o ovo..."

    r.CFrame = part.CFrame *
        CFrame.new(0,3,0)

    task.wait(0.4)

    if not ativo then return end

    if not fireproximityprompt then
        status.Text = "Interação não suportada"
        ignorados[part] = os.clock()+10
        return
    end

    status.Text = "Tentando coletar..."

    local ok = pcall(function()
        fireproximityprompt(prompt)
    end)

    if not ok then
        status.Text = "Erro na interação"
        ignorados[part] = os.clock()+10
        return
    end

    local inicio = os.clock()

    while ativo and os.clock()-inicio < 3 do
        if not prompt.Parent
            or not prompt.Enabled then
            break
        end
        task.wait(0.1)
    end

    if not ativo then return end

    ignorados[part] = os.clock()+8

    status.Text = "Voltando à base..."
    tpBase()

    task.wait(1.5)
end

-- DETECTAR ANÚNCIOS NO CHAT

pcall(function()
    TCS.MessageReceived:Connect(function(msg)
        local t = msg.Text
        if not t then return end

        local lower = t:lower()

        if lower:find(
            "a colossal egg has spawned in",
            1,true
        ) then
            ultimaRegiao =
                t:match("[Ss]pawned in%s+(.+)")
                or "Desconhecida"

            print(
                "Colossal anunciado em:",
                ultimaRegiao
            )

            if ativo and raridades.Colossal then
                status.Text =
                    "Colossal: " .. ultimaRegiao
            end
        end
    end)
end)

-- LOOP AUTOMÁTICO

task.spawn(function()
    while gui.Parent do
        task.wait(0.4)

        if ativo and not ocupado then
            ocupado = true

            for p,tempo in pairs(ignorados) do
                if os.clock() >= tempo
                    or not p.Parent then
                    ignorados[p] = nil
                end
            end

            local ovo = procurarOvo()

            if ovo then
                local ok,err = pcall(function()
                    coletar(ovo)
                end)

                if not ok then
                    warn("Egg Farm:",err)
                    status.Text = "Erro no Auto Farm"
                end
            else
                status.Text =
                    "Procurando ovos especiais..."
                task.wait(1)
            end

            ocupado = false
        end
    end
end)
