end)

-- IDENTIFICACAO DOS OVOS

local function textoOvo(modelo)
    local partes = {modelo.Name}

    for _,obj in ipairs(modelo:GetDescendants()) do
        if obj.Name == "EggNameTag" then
            if obj:IsA("TextLabel") then
                table.insert(partes,obj.Text)
            end

            for _,filho in ipairs(obj:GetDescendants()) do
                if filho:IsA("TextLabel") then
                    table.insert(partes,filho.Text)
                end
            end
        end
    end

    for _,nome in ipairs({
        "Rarity","EggName","Name"
    }) do
        local valor = modelo:GetAttribute(nome)

        if valor then
            table.insert(partes,tostring(valor))
        end
    end

    return normalizar(table.concat(partes," "))
end

local function permitido(modelo)
    local t = textoOvo(modelo)

    -- BLACKLIST: COSMICO
    if t:find("cosmico",1,true)
        or t:find("cosmic",1,true) then
        return false
    end

    return
        (filtros.segredo and (
            t:find("segredo",1,true)
            or t:find("secret",1,true)
        ))
        or (filtros.eterno and (
            t:find("eterno",1,true)
            or t:find("eternal",1,true)
        ))
        or (filtros.divino and (
            t:find("divino",1,true)
            or t:find("divine",1,true)
        ))
end

local function dadosOvo(modelo)
    local anchor = modelo:FindFirstChild(
        "PromptAnchor",true
    )

    local prompt = anchor and
        anchor:FindFirstChildWhichIsA(
            "ProximityPrompt",true
        )

    if not prompt then
        prompt = modelo:FindFirstChildWhichIsA(
            "ProximityPrompt",true
        )
    end

    local pos

    if anchor and anchor:IsA("BasePart") then
        pos = anchor.Position
    elseif anchor and anchor:IsA("Attachment") then
        pos = anchor.WorldPosition
    else
        local ok,pivot = pcall(function()
            return modelo:GetPivot()
        end)

        if ok then pos = pivot.Position end
    end

    return prompt,pos
end

local function procurarOvo(posicao)
    local pasta = workspace:FindFirstChild("Eggs")
    if not pasta then return nil end

    local melhor,menor = nil,distanciaRadar

    for _,modelo in ipairs(pasta:GetDescendants()) do
        if modelo:IsA("Model")
            and modelo.Name == "SpawnedEgg"
            and permitido(modelo) then

            local prompt,pos = dadosOvo(modelo)

            if prompt and prompt.Enabled and pos then
                local d = (pos-posicao).Magnitude

                if d < menor then
                    menor = d
                    melhor = {
                        modelo = modelo,
                        prompt = prompt,
                        pos = pos
                    }
                end
            end
        end
    end

    return melhor
end

-- DETECTAR OVO NA MAO

local function soltarVisivel()
    for _,obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextButton")
            or obj:IsA("ImageButton") then

            if not obj:IsDescendantOf(gui) then
                local t = normalizar(
                    obj.Name.." "..
                    (obj:IsA("TextButton") and obj.Text or "")
                )

                if t:find("soltar",1,true)
                    or t:find("drop",1,true) then

                    local visivel = obj.Visible
                    local pai = obj.Parent

                    while visivel and pai and pai ~= pg do
                        if pai:IsA("GuiObject")
                            and not pai.Visible then
                            visivel = false
                        end

                        pai = pai.Parent
                    end

                    if visivel then return true end
                end
            end
        end
    end

    return false
end

local function valido(id)
    return ativo
        and sessao == id
        and gui.Parent ~= nil
end

local function esperar(t,id)
    local inicio = os.clock()

    while os.clock()-inicio < t do
        if not valido(id) then return false end
        task.wait(.1)
    end

    return true
end

local function teleportar(pos,id,tempo)
    if not valido(id) then return false end

    local r = root()
    if not r then return false end

    r.CFrame = CFrame.new(
        pos+Vector3.new(0,3,0)
    )

    return esperar(tempo or velocidadeTP,id)
end

local function coletar(ovo,id)
    if not valido(id) then return false end

    atualizar("Coletando ovo")

    if type(fireproximityprompt) ~= "function" then
        atualizar("Prompt indisponível")
        return false
    end

    local ok = pcall(function()
        fireproximityprompt(ovo.prompt)
    end)

    if not ok then return false end

    local inicio = os.clock()

    while os.clock()-inicio < 7 do
        if not valido(id) then return false end
        if soltarVisivel() then return true end
        task.wait(.2)
    end

    return false
end

local function entregar(id)
    if not base then return false end

    atualizar("Levando ovo para base")

    local r = root()
    if not r then return false end

    r.CFrame = base

    if not esperar(velocidadeTP,id) then
        return false
    end

    local inicio = os.clock()

    while os.clock()-inicio < 15 do
        if not valido(id) then return false end

        if not soltarVisivel() then
            if esperar(.6,id)
                and not soltarVisivel() then

                entregas = entregas+1
                contador.Text =
                    "Ovos coletados: "..entregas

                atualizar("Ovo entregue")
                return true
            end
        end

        task.wait(.2)
    end

    atualizar("Entrega não confirmada")
    return false
end

-- AUTO FARM
-- BUSCA: 0.45 SEGUNDO
-- COLETA E ENTREGA: 1.10 SEGUNDO

local function iniciarFarm(id)
    task.spawn(function()
        while valido(id) do
            for _,ponto in ipairs(pontos) do
                if not valido(id) then break end

                atualizar("Procurando ovos")

                if not teleportar(
                    ponto,id,velocidadeBusca
                ) then
                    break
                end

                local ovo = procurarOvo(ponto)

                if ovo and valido(id) then
                    if teleportar(
                        ovo.pos,id,velocidadeTP
                    ) then

                        if coletar(ovo,id) then
                            if levarBase then
                                entregar(id)
                            else
                                atualizar("Ovo coletado na mão")

                                while valido(id)
                                    and soltarVisivel() do
                                    task.wait(.3)
                                end
                            end
                        end
                    end
                end
            end

            if valido(id) then
                esperar(.5,id)
            end
        end
    end)
end

conectar(farmBotao.MouseButton1Click,function()
    if not ativo and levarBase and not base then
        atualizar("Salve sua base primeiro")
        return
    end

    ativo = not ativo
    sessao = sessao+1

    farmBotao.Text = ativo
        and "Auto Farm: ON"
        or "Auto Farm: OFF"

    if ativo then
        iniciarFarm(sessao)
    else
        atualizar("Auto Farm desligado")
    end
end)

-- REDIMENSIONAR PAINEL

local ajustar = botao(
    "↕",
    UDim2.fromScale(.91,.89),
    UDim2.fromScale(.055,.085),
    conteudo
)

local redimensionando = false
local inicioToque = nil
local escalaInicial = escala.Scale

conectar(ajustar.InputBegan,function(input)
    if input.UserInputType ==
        Enum.UserInputType.Touch
        or input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        redimensionando = true
        inicioToque = input.Position
        escalaInicial = escala.Scale
    end
end)

conectar(UIS.InputChanged,function(input)
    if not redimensionando or not inicioToque then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.Touch
        or input.UserInputType ==
        Enum.UserInputType.MouseMovement then

        local delta = input.Position.Y-inicioToque.Y

        escala.Scale = math.clamp(
            escalaInicial+delta/350,
            .35,1.2
        )
    end
end)

conectar(UIS.InputEnded,function(input)
    if input.UserInputType ==
        Enum.UserInputType.Touch
        or input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        redimensionando = false
        inicioToque = nil
    end
end)

