-- DETECTAR BOTAO SOLTAR

local function botaoSoltarVisivel()
    for _,obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("GuiButton")
        and not obj:IsDescendantOf(gui) then

            local nome = normalizar(obj.Name)
            local achou =
                nome:find("soltar",1,true)
                or nome:find("drop",1,true)

            if obj:IsA("TextButton") then
                local t = normalizar(obj.Text)
                achou = achou
                    or t:find("soltar",1,true)
                    or t:find("drop",1,true)
            end

            if not achou then
                for _,filho in ipairs(
                    obj:GetDescendants()
                ) do
                    if filho:IsA("TextLabel") then
                        local t = normalizar(filho.Text)
                        if t:find("soltar",1,true)
                        or t:find("drop",1,true) then
                            achou = true
                            break
                        end
                    end
                end
            end

            if achou then
                local visivel = obj.Visible
                local pai = obj.Parent

                while visivel and pai do
                    if pai:IsA("GuiObject")
                    and not pai.Visible then
                        visivel = false
                    end

                    if pai:IsA("ScreenGui")
                    and not pai.Enabled then
                        visivel = false
                    end

                    if pai == pg then break end
                    pai = pai.Parent
                end

                if visivel then return true end
            end
        end
    end

    return false
end

-- IDENTIFICAR RARIDADE

local function raridade(ovo)
    local tag = ovo:FindFirstChild("EggNameTag",true)
    if not tag then return nil end

    for _,obj in ipairs(tag:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local t = normalizar(obj.Text)

            if filtros.segredo and (
                t:find("segredo",1,true)
                or t:find("secret",1,true)
            ) then
                return "segredo"
            end

            if filtros.eterno and (
                t:find("eterno",1,true)
                or t:find("eternal",1,true)
            ) then
                return "eterno"
            end

            if filtros.divino and (
                t:find("divino",1,true)
                or t:find("divine",1,true)
            ) then
                return "divino"
            end
        end
    end

    return nil
end

local function promptDoOvo(ovo)
    local a = ovo:FindFirstChild("PromptAnchor",true)
    return a and a:FindFirstChildWhichIsA(
        "ProximityPrompt",true
    )
end

local function posicao(ovo)
    local a = ovo:FindFirstChild("PromptAnchor",true)

    if a then
        if a:IsA("BasePart") then
            return a.Position
        elseif a:IsA("Attachment") then
            return a.WorldPosition
        end
    end

    return ovo:GetPivot().Position
end

local function chocando(ovo)
    if not ignorarChocando then
        return false
    end

    local n = normalizar(ovo.Name)
    return n:find("hatch",1,true) ~= nil
        or n:find("chocando",1,true) ~= nil
end

-- RADAR

local function procurarNaArea(ponto,ignorados)
    local pasta = workspace:FindFirstChild("Eggs")
    if not pasta then return nil end

    local melhor,menor = nil,math.huge

    for _,ovo in ipairs(pasta:GetDescendants()) do
        if ovo:IsA("Model")
        and ovo.Name == "SpawnedEgg"
        and not ignorados[ovo]
        and not chocando(ovo)
        and raridade(ovo) then

            local prompt = promptDoOvo(ovo)

            if prompt and prompt.Enabled then
                local d = (posicao(ovo)-ponto).Magnitude

                if d <= RADAR and d < menor then
                    melhor = ovo
                    menor = d
                end
            end
        end
    end

    return melhor
end

-- TELEPORTE

local function teleportar(ponto,ciclo)
    local r = root()

    if not r or not valido(ciclo) then
        return false
    end

    r.CFrame = CFrame.new(
        ponto+Vector3.new(0,3,0)
    )

    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    return esperar(TP_DELAY,ciclo)
end

-- COLETA

local function coletar(prompt,ciclo)
    if not prompt or not prompt.Parent then
        return false
    end

    if type(fireproximityprompt) ~= "function" then
        atualizar("Coleta indisponivel")
        return false
    end

    if not esperar(.2,ciclo) then
        return false
    end

    return pcall(function()
        fireproximityprompt(prompt)
    end)
end

local function esperarSegurando(ciclo)
    local limite = os.clock()+TEMPO_COLETA

    while os.clock()<limite do
        if not valido(ciclo) then return false end

        if botaoSoltarVisivel() then
            return true
        end

        task.wait(.1)
    end

    return false
end

-- ENTREGAR NA BASE

local function entregarNaBase(ciclo)
    if not base or not valido(ciclo) then
        return false
    end

    local r = root()
    if not r then return false end

    atualizar("Levando ovo a base")

    r.CFrame = base
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    if not esperar(.5,ciclo) then
        return false
    end

    local limite = os.clock()+TEMPO_ENTREGA
    local sumiuDesde = nil

    while os.clock()<limite do
        if not valido(ciclo) then return false end

        if not botaoSoltarVisivel() then
            if not sumiuDesde then
                sumiuDesde = os.clock()
            end

            if os.clock()-sumiuDesde >= .6 then
                return true
            end
        else
            sumiuDesde = nil
            atualizar("Aguardando deposito")
        end

        task.wait(.1)
    end

    return false
end

