-- OTIMIZACAO
local function ocultar(obj)
    if obj and obj.Parent and not ocultos[obj] then
        ocultos[obj] = obj.Parent
        obj.Parent = nil
    end
end

local function aplicarOtimizacao()
    ocultar(workspace:FindFirstChild("FuseMachineKit"))
    ocultar(workspace:FindFirstChild("MutationMachineKit"))

    for _,plot in ipairs(workspace:GetChildren()) do
        if plot.Name:match("^Plot_") then
            ocultar(plot:FindFirstChild("EggHatch"))

            for _,obj in ipairs(plot:GetChildren()) do
                if obj.Name == "TreadmillModel" then
                    ocultar(obj)
                end
            end

            local estrutura = plot:FindFirstChild("Base")
            if estrutura then
                for _,obj in ipairs(estrutura:GetChildren()) do
                    if obj.Name == "Part"
                        and obj:IsA("BasePart") then
                        ocultar(obj)
                    end
                end
            end
        end
    end

    local mapa = workspace:FindFirstChild("Map")
    if mapa then
        ocultar(mapa:FindFirstChild("Decor"))
    end
end

local function restaurarOtimizacao()
    for obj,pai in pairs(ocultos) do
        if obj and pai then
            pcall(function()
                obj.Parent = pai
            end)
        end
        ocultos[obj] = nil
    end
end

conectar(bOtimizar.MouseButton1Click,function()
