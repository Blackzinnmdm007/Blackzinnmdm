local function funcionando()
    return not encerrado and gui.Parent ~= nil
end

local function valido(ciclo)
    return funcionando() and ativo and sessao == ciclo
end

local function esperar(segundos,ciclo)
    local fim = os.clock()+segundos
    while os.clock()<fim do
        if not valido(ciclo) then return false end
        task.wait(.05)
    end
    return valido(ciclo)
end

