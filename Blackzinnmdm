local function criar(tipo,props,pai)
    local obj = Instance.new(tipo)
    for k,v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = pai
    return obj
end

local function canto(obj)
    criar("UICorner",{
        CornerRadius = UDim.new(0,9)
    },obj)
end

local function borda(obj)
    criar("UIStroke",{
        Color = roxo,
        Thickness = 1.5
    },obj)
end

local function texto(t,p,s,pai,sz)
    return criar("TextLabel",{
        Text = t,
        Position = p,
        Size = s,
        BackgroundTransparency = 1,
        TextColor3 = branco,
        TextSize = sz or 14,
        Font = Enum.Font.GothamBold,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 5
    },pai)
end

local function botao(t,p,s,pai,sz)
    local b = criar("TextButton",{
        Text = t,
        Position = p,
        Size = s,
        BackgroundColor3 = painel,
        TextColor3 = branco,
        TextSize = sz or 14,
        Font = Enum.Font.GothamBold,
        TextWrapped = true,
        ZIndex = 6
    },pai)
    canto(b)
    borda(b)
    return b
end

local function normalizar(t)
    t = tostring(t or ""):lower()
    local mapa = {
        ["á"]="a",["à"]="a",["ã"]="a",
        ["â"]="a",["é"]="e",["ê"]="e",
        ["í"]="i",["ó"]="o",["ô"]="o",
        ["õ"]="o",["ú"]="u",["ç"]="c"
    }
    for a,b in pairs(mapa) do
        t = t:gsub(a,b)
    end
    return t
end

local function root()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

