local function arrastar(obj,alvo)
    local movendo = false
    local entrada,inicio,original

    alvo.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            movendo = true
            entrada = i
            inicio = i.Position
            original = obj.Position
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if movendo and (
            i == entrada or
            i.UserInputType ==
            Enum.UserInputType.MouseMovement
        ) then
            local d = i.Position-inicio
            obj.Position = UDim2.new(
                original.X.Scale,
                original.X.Offset+d.X,
                original.Y.Scale,
                original.Y.Offset+d.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i == entrada then
            movendo = false
        end
    end)
end

