-- CICLO PRINCIPAL

task.spawn(function()
    while funcionando() do
        if ativo then
            local ciclo = sessao
            local ignorados = {}

            for i,ponto in ipairs(coordenadas) do
                if not valido(ciclo) then break end

                if botaoSoltarVisivel() then
                    atualizar("Ovo na mao")

                    if entregarNaBase(ciclo) then
                        entregues += 1
                        contador.Text =
                            "Entregas: "..entregues
                        atualizar("Ovo depositado")
                    else
                        atualizar("Entrega nao confirmada")
                        break
                    end
                end

                atualizar("Area "..i.."/17")

                if not teleportar(ponto,ciclo) then
                    break
                end

                local alvo = procurarNaArea(
                    ponto,ignorados
                )

                if alvo and valido(ciclo) then
                    atualizar("Ovo localizado")

                    if teleportar(
                        posicao(alvo),ciclo
                    ) then
                        atualizar("Coletando ovo")
                        local prompt = promptDoOvo(alvo)

                        if coletar(prompt,ciclo)
                        and esperarSegurando(ciclo) then

                            atualizar("Ovo na mao")

                            if levarBase then
                                if entregarNaBase(ciclo) then
                                    entregues += 1
                                    contador.Text =
                                        "Entregas: "..entregues
                                    atualizar("Ovo depositado")
                                else
                                    atualizar(
                                        "Entrega nao confirmada"
                                    )
                                    break
                                end
                            else
                                atualizar("Ovo coletado")
                            end
                        else
                            atualizar(
                                "Coleta nao confirmada"
                            )
                        end
                    end

                    ignorados[alvo] = true
                end
            end
        else
            task.wait(.25)
        end

        task.wait(.1)
    end
end)
