local function requisitarServidores(url)
    local req = (syn and syn.request) or http_request or request
    if type(req) ~= "function" then
        error("Seu executor nao oferece requisicoes HTTP")
    end
    local resposta = req({Url=url, Method="GET"})
    if not resposta or tonumber(resposta.StatusCode) ~= 200 then
        error("Falha ao consultar servidores: " .. tostring(resposta and resposta.StatusCode))
    end
    return HttpService:JSONDecode(resposta.Body)
end

