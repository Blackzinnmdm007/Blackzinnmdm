local function normalizar(t)
    t = tostring(t or ""):lower()
    local trocas = {
        ["á"]="a",["à"]="a",["ã"]="a",
        ["â"]="a",["é"]="e",["ê"]="e",
        ["í"]="i",["ó"]="o",["ô"]="o",
        ["õ"]="o",["ú"]="u",["ç"]="c"
    }
    for a,b in pairs(trocas) do
        t = t:gsub(a,b)
    end
    return t
end

