    end
end)

-- DESYNC LOCAL COM JOYSTICK

local joystickGui = nil
local direcaoJoystick = Vector2.zero
local cameraAnterior = nil
local controleClone = nil

local function pararDesync()
    desync = false
    direcaoJoystick = Vector2.zero

    if controleClone then
        controleClone:Disconnect()
        controleClone = nil
    end

    if joystickGui then
        joystickGui:Destroy()
        joystickGui = nil
    end

    if clone then
        clone:Destroy()
        clone = nil
    end

    local cameraAtual = workspace.CurrentCamera
    local char = player.Character
    local humanoid = char and
        char:FindFirstChildOfClass("Humanoid")

    if cameraAtual then
        cameraAtual.CameraType = Enum.CameraType.Custom

        if humanoid then
            cameraAtual.CameraSubject = humanoid
        elseif cameraAnterior then
            cameraAtual.CameraSubject = cameraAnterior
        end
    end

    bDesync.Text = "[ ] Desync"
end

local function iniciarDesync()
    if desync then return end

    local char = player.Character
    local r = root()

    if not char or not r then
        atualizar("Personagem indisponível")
        return
    end

    local antigoArchivable = char.Archivable
    char.Archivable = true

    local ok,novoClone = pcall(function()
        return char:Clone()
    end)

    char.Archivable = antigoArchivable

    if not ok or not novoClone then
        atualizar("Falha ao criar clone")
        return
    end

    clone = novoClone
    clone.Name = "BlackzinnmdmClone"

    for _,obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("BaseScript") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
        end
    end

    clone.Parent = workspace

    local cloneRoot =
        clone:FindFirstChild("HumanoidRootPart")

    local cloneHumanoid =
        clone:FindFirstChildOfClass("Humanoid")

    if not cloneRoot or not cloneHumanoid then
        pararDesync()
        atualizar("Clone inválido")
        return
    end

    cloneRoot.CFrame = r.CFrame
    cloneRoot.Anchored = true

    desync = true
    bDesync.Text = "[X] Desync"

    local cameraAtual = workspace.CurrentCamera

    if cameraAtual then
        cameraAnterior = cameraAtual.CameraSubject
        cameraAtual.CameraType = Enum.CameraType.Custom
        cameraAtual.CameraSubject = cloneHumanoid
    end

    joystickGui = criar("Frame",{
        Name = "JoystickClone",
        Size = UDim2.fromOffset(130,130),
        Position = UDim2.new(0,25,1,-165),
        BackgroundColor3 = Color3.fromRGB(25,10,45),
        BackgroundTransparency = .25,
        Active = true,
        ZIndex = 20
    },gui)

    criar("UICorner",{
        CornerRadius = UDim.new(1,0)
    },joystickGui)

    criar("UIStroke",{
        Color = roxo,
        Thickness = 2
    },joystickGui)

    local bolinha = criar("Frame",{
        Size = UDim2.fromOffset(52,52),
        AnchorPoint = Vector2.new(.5,.5),
        Position = UDim2.fromScale(.5,.5),
        BackgroundColor3 = roxo,
        ZIndex = 21
    },joystickGui)

    criar("UICorner",{
        CornerRadius = UDim.new(1,0)
    },bolinha)

    local toqueAtivo = nil

    local function moverJoystick(pos)
        if not joystickGui or not joystickGui.Parent then
            return
        end

        local centro =
            joystickGui.AbsolutePosition
            + joystickGui.AbsoluteSize/2

        local delta = Vector2.new(
            pos.X-centro.X,
            pos.Y-centro.Y
        )

        local raio = 39

        if delta.Magnitude > raio then
            delta = delta.Unit*raio
        end

        direcaoJoystick = delta/raio

        bolinha.Position = UDim2.new(
            .5,delta.X,
            .5,delta.Y
        )
    end

    local function soltarJoystick()
        toqueAtivo = nil
        direcaoJoystick = Vector2.zero

        if bolinha.Parent then
            bolinha.Position = UDim2.fromScale(.5,.5)
        end
    end

    conectar(joystickGui.InputBegan,function(input)
        if input.UserInputType ==
            Enum.UserInputType.Touch
            or input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            toqueAtivo = input
            moverJoystick(input.Position)
        end
    end)

    conectar(UIS.InputChanged,function(input)
        if not desync or not toqueAtivo then
            return
        end

        if input == toqueAtivo or
            (toqueAtivo.UserInputType ==
                Enum.UserInputType.MouseButton1
                and input.UserInputType ==
                Enum.UserInputType.MouseMovement) then

            moverJoystick(input.Position)
        end
    end)

    conectar(UIS.InputEnded,function(input)
        if input == toqueAtivo then
            soltarJoystick()
        end
    end)

    controleClone =
        RunService.RenderStepped:Connect(function(dt)

        if not desync or not clone
            or not clone.Parent then
            return
        end

        local cr =
            clone:FindFirstChild("HumanoidRootPart")

        local camAtual = workspace.CurrentCamera

        if not cr or not camAtual then
            return
        end

        local frente = camAtual.CFrame.LookVector
        local direita = camAtual.CFrame.RightVector

        frente = Vector3.new(
            frente.X,0,frente.Z
        )

        direita = Vector3.new(
            direita.X,0,direita.Z
        )

        if frente.Magnitude > 0 then
            frente = frente.Unit
        end

        if direita.Magnitude > 0 then
            direita = direita.Unit
        end

        local movimento =
            direita*direcaoJoystick.X
            - frente*direcaoJoystick.Y

        if movimento.Magnitude > 1 then
            movimento = movimento.Unit
        end

        if movimento.Magnitude > 0 then
            local novaPos =
                cr.Position+movimento*16*dt

            cr.CFrame = CFrame.lookAt(
                novaPos,
                novaPos+movimento
            )
        end
    end)

    atualizar("Desync local ativado")
end

