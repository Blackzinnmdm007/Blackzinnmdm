local function make(class, props, parent)
    local x = Instance.new(class)
    for k,v in pairs(props) do
        x[k] = v
    end
    x.Parent = parent
    return x
end

local function corner(obj,r)
    make("UICorner",{
        CornerRadius = UDim.new(0,r)
    },obj)
end

local function stroke(obj,color,width)
    make("UIStroke",{
        Color = color or C.blue,
        Thickness = width or 1
    },obj)
end

local function normalize(s)
    s = tostring(s or ""):lower()

    local accents = {
        ["á"]="a",["à"]="a",["â"]="a",
        ["ã"]="a",["é"]="e",["ê"]="e",
        ["í"]="i",["ó"]="o",["ô"]="o",
        ["õ"]="o",["ú"]="u",["ç"]="c"
    }

    for a,b in pairs(accents) do
        s = s:gsub(a,b)
    end

    return s
end

local function contains(s,words)
    for _,word in ipairs(words) do
        if s:find(word,1,true) then
            return true
        end
    end
    return false
end

local function root()
    local c = player.Character
    return c and c:FindFirstChild(
        "HumanoidRootPart"
    )
end

local function teleport(cf)
    local c = player.Character
    if not c or not cf then return false end
    c:PivotTo(cf)
    return true
end

local function position(obj)
    local x = obj

    while x do
        if x:IsA("Attachment") then
            return x.WorldPosition
        end

        if x:IsA("BasePart") then
            return x.Position
        end

        x = x.Parent
    end

    return nil
end

local function nearBase(p)
    if not base or not p then return false end

    local a = Vector3.new(p.X,0,p.Z)
    local b = Vector3.new(
        base.Position.X,0,base.Position.Z
    )

    return (a-b).Magnitude <= cfg.BaseRadius
end

local function textOf(obj)
    if not obj then return "" end

    local parts = {obj.Name}

    if obj:IsA("ProximityPrompt") then
        table.insert(parts,obj.ActionText)
        table.insert(parts,obj.ObjectText)
    elseif obj:IsA("TextLabel")
        or obj:IsA("TextButton") then
        table.insert(parts,obj.Text)
    end

    for _,key in ipairs({
        "Rarity","Raridade",
        "EggRarity","EggType"
    }) do
        local value = obj:GetAttribute(key)
        if value ~= nil then
            table.insert(parts,tostring(value))
        end
    end

    return normalize(table.concat(parts," "))
end

local function forbidden(obj)
    local x = obj

    while x and x ~= Workspace do
        if contains(normalize(x.Name),{
            "equipped","equipado",
            "followers","petfollowers",
            "activepets","incubator",
            "chocadeira","hatching",
            "chocando","incubando"
        }) then
            return true
        end

        for _,key in ipairs({
            "Equipped","IsEquipped",
            "Following","IsHatching",
            "IsIncubating"
        }) do
            if x:GetAttribute(key) == true then
                return true
            end
        end

        x = x.Parent
    end

    return false
end

local function isEggPrompt(prompt)
    return contains(textOf(prompt),{
        "coletar ovo","collect egg",
        "pegar ovo","pickup egg"
    })
end

-- CLASSIFICACAO EXCLUSIVA

local function classify(text)
    text = normalize(text)

    if contains(text,{
        "cosmico","cosmic",
        "mitico","mythic",
        "lendario","legendary",
        "epico","epic",
        "comum","common",
        "raro","rare"
    }) then
        return "BLOCK"
    end

    if contains(text,{"segredo","secret"}) then
        return "Segredo"
    end

    if contains(text,{"eterno","eternal"}) then
        return "Eterno"
    end

    if contains(text,{
        "divino","divina","divine"
    }) then
        return "Divino"
    end

    return nil
end

local function eggModel(prompt)
    local x = prompt.Parent

    while x and x ~= Workspace do
        if x:IsA("Model") then
            return x
        end
        x = x.Parent
    end

    return nil
end

-- DETECTAR RARIDADE DO PROPRIO OVO

local function detect(prompt)
    local model = eggModel(prompt)

    if not model or forbidden(model) then
        return nil
    end

    local found = {}
    local blocked = false

    local function check(value)
        local result = classify(value)

        if result == "BLOCK" then
            blocked = true
        elseif result then
            found[result] = true
        end
    end

    check(textOf(prompt))
    check(textOf(model))

    local count = 0

    for _,obj in ipairs(
        model:GetDescendants()
    ) do
        count = count + 1

        if obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("StringValue") then

            check(textOf(obj))

            if obj:IsA("StringValue") then
                check(obj.Value)
            end
        end

        if count >= 350 then break end
    end

    if blocked then return nil end

    local selected
    local total = 0

    for rarity in pairs(found) do
        selected = rarity
        total = total + 1
    end

    if total ~= 1 then return nil end
    if not cfg[selected] then return nil end

    return selected
end

