local function desligarClone()
    cameraOriginal()
    if cloneBase then
        cloneBase:Destroy()
        cloneBase=nil
    end
    if bDesync.Parent then
        bDesync.Text="[ ] Desync (Clone na Base)"
        bDesync.BackgroundColor3=branco
    end
end
local function ligarClone()
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then
        atualizar("Personagem nao encontrado")
        return
    end
    local anterior=char.Archivable
    char.Archivable=true
    local ok,copia=pcall(function() return char:Clone() end)
    char.Archivable=anterior
    if not ok or not copia then
        atualizar("Falha ao criar clone")
        return
    end
    for _,obj in ipairs(copia:GetDescendants()) do
        if obj:IsA("BaseScript") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored=true
            obj.CanCollide=false
            obj.CanTouch=false
            obj.CanQuery=false
        end
    end
    copia.Name="BlackzinnCloneLocal"
    copia.Parent=workspace
    copia:PivotTo(CFrame.new(24.713,3.000,86.558))
    local humanoidClone=copia:FindFirstChildOfClass("Humanoid")
    if not humanoidClone then
        copia:Destroy()
        atualizar("Clone sem Humanoid")
        return
    end
    cloneBase=copia
    local camera=workspace.CurrentCamera
    if camera then
        camera.CameraType=Enum.CameraType.Custom
        camera.CameraSubject=humanoidClone
    end
    bDesync.Text="[X] Desync (Clone na Base)"
    bDesync.BackgroundColor3=Color3.fromRGB(85,92,105)
    atualizar("Camera no clone; Auto Farm segue no personagem")
end
