-- BUSCA DOS OVOS

local function normalize(value)
    local s = tostring(value or ""):lower()
    return s:gsub("á","a")
        :gsub("é","e")
        :gsub("í","i")
        :gsub("ó","o")
        :gsub("ú","u")
end

local function rarityOf(obj)
    local parts = {
        normalize(obj.Name),
        normalize(obj:GetAttribute("Rarity")),
        normalize(obj:GetAttribute("Raridade"))
    }

    for _,d in ipairs(obj:GetDescendants()) do
        if d:IsA("TextLabel") then
            table.insert(parts,normalize(d.Text))
        elseif d:IsA("StringValue") then
            table.insert(parts,normalize(d.Value))
        end
    end

    local combined = table.concat(parts," ")

    for _,name in ipairs({"Segredo","Eterno","Divino"}) do
        if combined:find(normalize(name),1,true) then
            return name
        end
    end

    return nil
end

local function excluded(obj)
    local current = obj

    while current and current ~= WS do
        local name = normalize(current.Name)

        if name:find("plant",1,true)
        or name:find("incubat",1,true)
        or name:find("equip",1,true)
        or name:find("pet",1,true)
        or current:GetAttribute("Planted") == true
        or current:GetAttribute("Equipped") == true then
            return true
        end

        current = current.Parent
    end

    return false
end

local function findEgg()
    local root = getRoot()
    if not root then return nil end

    local nearest
    local distance = math.huge

    for _,obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("Model") then
            local name = normalize(obj.Name)

            if name:find("egg",1,true)
            or name:find("ovo",1,true) then
                if not excluded(obj) then
                    local rarity = rarityOf(obj)

                    if rarity and selected[rarity] then
                        local pos = obj:GetPivot().Position

                        local nearBase = basePosition
                            and (pos-basePosition).Magnitude < 25

                        if not nearBase then
                            local prompt = obj:FindFirstChildWhichIsA(
                                "ProximityPrompt",true
                            )

                            if prompt then
                                local d = (pos-root.Position).Magnitude

                                if d < distance then
                                    distance = d
                                    nearest = {
                                        position = pos,
                                        prompt = prompt,
                                        rarity = rarity
                                    }
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return nearest
end

-- CONTROLE DO FARM

local function updateState()
    stateLabel.Text = running
        and "AUTO FARM: ON"
        or "AUTO FARM: OFF"

    toggle.Text = running
        and "TERMINAR"
        or "INICIAR"

    toggle.BackgroundColor3 = running
        and Color3.fromRGB(0,85,155)
        or DARK

    statusDetails.Text = running
        and "AUTO FARM LIGADO"
        or "AUTO FARM DESLIGADO"
end

local function farmLoop()
    if workerActive then return end
    workerActive = true

    while running do
        for i,pos in ipairs(areas) do
            if not running then break end

            routeIndex = i
            routeDetails.Text = "ROTA: "..i.."/17"
            areaLabel.Text = "ÁREA DA ROTA: "..i.."/17"
            statusLabel.Text = "STATUS: PROCURANDO"

            teleport(pos)
            task.wait(0.18)

            local egg = findEgg()

            if egg and running then
                statusLabel.Text = "STATUS: "..egg.rarity

                teleport(
                    egg.position + Vector3.new(0,2,0)
                )

                task.wait(0.12)

                if running and egg.prompt.Parent then
                    if typeof(fireproximityprompt) == "function" then
                        pcall(function()
                            fireproximityprompt(egg.prompt)
                        end)
                    else
                        statusLabel.Text =
                            "STATUS: PROMPT INDISPONÍVEL"
                    end

                    attempts = attempts + 1
                    eggLabel.Text =
                        "TENTATIVAS DE COLETA: "..attempts
                    attemptDetails.Text =
                        "TENTATIVAS DE COLETA: "..attempts
                end

                if running and basePosition then
                    teleport(
                        basePosition + Vector3.new(0,2,0)
                    )
                    statusLabel.Text =
                        "STATUS: AGUARDANDO NA BASE"

                    task.wait(3)
                end
            end
        end

        task.wait()
    end

    workerActive = false
    statusLabel.Text = "STATUS: PARADO"
end

toggle.Activated:Connect(function()
    if not running and not basePosition then
        statusLabel.Text = "SALVE SUA BASE PRIMEIRO"
        openTab("Principal")
        return
    end

    running = not running
    updateState()

    if running then
        task.spawn(farmLoop)
    end
end)

